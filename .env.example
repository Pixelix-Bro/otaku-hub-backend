# Application
NODE_ENV=production
PORT=3000

# Public URLs
PUBLIC_BASE_URL=https://your-domain.com
PUBLIC_API_URL=https://api.your-domain.com
PUBLIC_WEB_URL=https://your-domain.com

# MongoDB
MONGODB_URI=mongodb+srv://USERNAME:YOUR_PASSWORD@CLUSTER.mongodb.net/
MONGODB_DB=XENVO

# Backend Telegram Bot API credentials
BOT_TOKEN=123456:ABCDEF-abcdef_1234567890
# Worker-only MTProto credentials. Do not configure these on the Railway backend service.
API_ID=12345678
API_HASH=replace_with_real_api_hash
TELEGRAM_BOT_USERNAME=xenvo_bot
TELEGRAM_WEBHOOK_SECRET=replace-with-a-long-random-secret-string
# Worker-only session path
TELEGRAM_SESSION_PATH=./xenvo_mtproto.session
# Backend-to-worker connection: configure both values together.
TELEGRAM_WORKER_SECRET=replace-with-a-long-random-secret-string
TELEGRAM_WORKER_URL=http://127.0.0.1:8000
TELEGRAM_ADMIN_IDS=123456789
ADMIN_API_TOKEN=replace-with-a-long-random-admin-api-token
TELEGRAM_STORAGE_CHAT_ID=-1001234567890

# Security and watch tokens
MEDIA_LINK_SECRET=replace-with-a-long-random-secret-string
WATCH_TOKEN_TTL_SECONDS=3600
MAX_WATCH_TOKEN_USES=10
STREAM_CHUNK_BYTES=524288
MEDIA_CHUNK_CACHE_BYTES=67108864
MAX_ACTIVE_STREAMS=10

# Bot preview limits
BOT_API_DOWNLOAD_MAX_BYTES=19922944

# Logging
LOG_LEVEL=info

# Optional: Redis for cache or rate limiting
# REDIS_URL=redis://redis:6379
