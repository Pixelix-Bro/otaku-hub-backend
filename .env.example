# Telegram Bot Token
# Get from BotFather on Telegram: https://t.me/BotFather
TOKEN=your_telegram_bot_token_here

# Telegram API credentials
# Get from https://my.telegram.org/apps
API_ID=123456789
API_HASH=your_api_hash_here

# Server port (Vercel ignores this, uses auto-assigned port)
PORT=3050

# Public URL for API responses
# On Vercel: https://your-project-name.vercel.app
# On localhost: http://localhost:3050
PUBLIC_URL=http://localhost:3050

# Optional: Admin ID for future admin features
ADMIN_ID=your_admin_telegram_id
