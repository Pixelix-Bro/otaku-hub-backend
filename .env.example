# Application
NODE_ENV=production
PORT=3000

# Public URLs
PUBLIC_API_URL=https://your-api-domain.com
PUBLIC_WEB_URL=https://your-website-domain.com

# MongoDB
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/otaku_hub?retryWrites=true&w=majority
MONGODB_DB=otaku_hub

# Telegram Bot API (official hosted Bot API only)
TELEGRAM_BOT_TOKEN=123456:ABCDEF-abcdef_1234567890
TELEGRAM_BOT_USERNAME=your_bot_username
TELEGRAM_STORAGE_CHAT_ID=-1001234567890
TELEGRAM_WEBHOOK_SECRET=replace-with-a-long-random-secret-string

# Admins
ADMIN_TELEGRAM_IDS=123456789,987654321

# Security
MEDIA_LINK_SECRET=replace-with-a-long-random-secret-string

# Preview limits
BOT_API_DOWNLOAD_MAX_BYTES=19922944

# Watch token settings
WATCH_TOKEN_TTL_SECONDS=604800
MAX_WATCH_TOKEN_USES=10

# Logging
LOG_LEVEL=info
