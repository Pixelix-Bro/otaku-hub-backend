# Application
NODE_ENV=production
PORT=3000

# Public URLs
PUBLIC_BASE_URL=https://your-domain.com
PUBLIC_API_URL=https://api.your-domain.com
PUBLIC_WEB_URL=https://your-domain.com

# MongoDB
MONGODB_URI=mongodb+srv://USERNAME:YOUR_PASSWORD@CLUSTER.mongodb.net/
MONGODB_DB=XENVO

# Backend Telegram Bot API credentials
BOT_TOKEN=123456:ABCDEF-abcdef_1234567890
TELEGRAM_BOT_USERNAME=xenvo_bot
TELEGRAM_WEBHOOK_SECRET=replace-with-a-long-random-secret-string
TELEGRAM_ADMIN_IDS=123456789
ADMIN_API_TOKEN=replace-with-a-long-random-admin-api-token
TELEGRAM_STORAGE_CHAT_ID=-1001234567890

# Bot API endpoint (default: Telegram hosted API)
TELEGRAM_BOT_API_BASE_URL=https://api.telegram.org

# Optional MTProto byte-range streaming (use bot API credentials from my.telegram.org)
TELEGRAM_MTPROTO_API_ID=
TELEGRAM_MTPROTO_API_HASH=
TELEGRAM_MTPROTO_SESSION=
TELEGRAM_MTPROTO_MAX_CONCURRENT_DOWNLOADS=6
TELEGRAM_MTPROTO_REQUEST_SIZE_BYTES=524288

# Security and watch tokens
MEDIA_LINK_SECRET=replace-with-a-long-random-secret-string
WATCH_TOKEN_TTL_SECONDS=3600
MAX_WATCH_TOKEN_USES=10

# Logging
LOG_LEVEL=info

# Optional: Redis for cache or rate limiting
# REDIS_URL=redis://redis:6379
